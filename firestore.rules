rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only touch their OWN documents — enforced by Firebase.
    // Paste this into: Firebase Console → Firestore Database → Rules → Publish.
    // (the first block covers the profile doc users/{uid}, the second
    //  covers diagnoses / sell analyses saved under it)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── The marketplace ──────────────────────────────────────────────
    // A PUBLIC board: anyone (even signed out) may read every listing,
    // because that is the whole point — a farmer must be able to find a
    // buyer without an account. Only the author may change or remove
    // their own post.
    match /marketPosts/{postId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.authorId == request.auth.uid;
    }

    // Responses to a listing. Publicly readable — the author has to see who
    // responded — but only the two people involved may write.
    match /marketInterests/{interestId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.fromId == request.auth.uid;
      allow update: if request.auth != null
                    && (resource.data.fromId == request.auth.uid
                        || resource.data.toId == request.auth.uid);
      allow delete: if false;
    }

    // Everything else is private by default (deny all).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
