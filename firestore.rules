rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only touch their OWN documents — enforced by Firebase.
    // Paste this into: Firebase Console → Firestore Database → Rules → Publish.
    // (the first block covers the profile doc users/{uid}, the second
    //  covers diagnoses / sell analyses saved under it)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Everything else is private by default (deny all).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
