# ─────────────────────────────────────────────────────────────
# KrishiSathi environment variables — COPY THIS FILE to ".env"
# and fill in your own keys. NEVER commit the real .env to Git.
# ─────────────────────────────────────────────────────────────

# Port the backend runs on (optional, default 3000)
PORT=3000

# ── Groq (LLM + Vision) — https://console.groq.com → API Keys ──
# Free tier: gpt-oss-120b (chat/reasoning) + qwen/qwen3.8-27b (vision)
GROQ_API_KEY=

# ── data.gov.in (AGMARKNET mandi prices) — https://data.gov.in → sign up → My Account → API key ──
DATA_GOV_IN_API_KEY=

# ── Cloudinary (image storage) — https://cloudinary.com → Console → Dashboard ──
# All three values are on the Console "Getting Started" page.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# NOTE: Open-Meteo (weather) needs NO key.
# NOTE: Firebase keys go in public/js/firebase-config.js (they are public by design;
#       security is enforced by Firestore Rules, not by hiding these keys).
